# Beispiel — die echte Datei liegt AUSSERHALB des Repos.
#
# 1. Keystore erzeugen (einmalig):
#    keytool -genkeypair -keystore ~/.android-keys/sidekeys/sidekeys.jks \
#      -alias sidekeys -keyalg RSA -keysize 4096 -validity 10000
#
# 2. Diese Datei nach ~/.android-keys/sidekeys/keystore.properties kopieren
#    und die Werte eintragen.
#
# 3. Vor dem Build exportieren:
#    export SIDEKEYS_KEYSTORE_DIR=~/.android-keys/sidekeys
#
# Ohne diese Variable schlägt der Release-Build bewusst fehl (kein versehentlich
# debug-signiertes „Release"). Für ein lokales Testbuild:
#    ./gradlew assembleRelease -PallowDebugSigning

storeFile=sidekeys.jks
storePassword=DEIN_STARKES_PASSWORT
keyAlias=sidekeys
keyPassword=DEIN_STARKES_PASSWORT
